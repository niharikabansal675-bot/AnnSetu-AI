# Local laptop: fallback only. Never commit real keys or model weights.
ANNSETU_USE_MODEL=false
ANNSETU_BASE_MODEL=Qwen/Qwen3-0.6B
# Set this to extracted adapter folder on a CUDA GPU machine only:
ANNSETU_ADAPTER_PATH=
# Set a private shared secret before exposing the API on a network:
ANNSETU_SERVICE_KEY=
